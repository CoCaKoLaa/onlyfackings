{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onlyfackings",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlyfackings-production",
      "database_id": "0bb9a713-db58-4bfc-8411-dbeaade6d6fe"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "sugarbot8@gmail.com",
    "PUBLIC_BASE_URL": "https://onlyfackings.com",
    "EMAIL_FROM": "cuentas@onlyfackings.com",
    "TERMS_VERSION": "draft-1"
  }
}
